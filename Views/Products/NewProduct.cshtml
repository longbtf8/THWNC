@model Product

@{
    ViewData["Title"] = "Thêm mặt hàng";
}

<h1>Thêm mặt hàng</h1>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<form asp-action="NewProduct" method="post" class="mt-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="ProductID" class="form-label"></label>
        <input asp-for="ProductID" class="form-control" min="1" />
        <span asp-validation-for="ProductID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProductName" class="form-label"></label>
        <input asp-for="ProductName" class="form-control" />
        <span asp-validation-for="ProductName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ImageURL" class="form-label"></label>
        <input asp-for="ImageURL" class="form-control" />
        <span asp-validation-for="ImageURL" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProductPrice" class="form-label"></label>
        <input asp-for="ProductPrice" class="form-control" type="number" min="0" step="0.01" />
        <span asp-validation-for="ProductPrice" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Thêm mới</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
