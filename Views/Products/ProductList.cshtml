@model List<Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<h1>Danh sách sản phẩm</h1>

<table class="table table-bordered table-striped mt-4">
    <thead>
        <tr>
            <th>STT</th>
            <th>Tên hàng</th>
            <th>Đơn giá</th>
            <th>Mô tả</th>
        </tr>
    </thead>
    <tbody>
        @for (var i = 0; i < Model.Count; i++)
        {
            <tr>
                <td>@(i + 1)</td>
                <td>
                    <a asp-action="ProductDetail" asp-route-id="@Model[i].ProductID">@Model[i].ProductName</a>
                </td>
                <td>@Model[i].ProductPrice.ToString("N0") VND</td>
                <td>@Model[i].Description</td>
            </tr>
        }
    </tbody>
</table>
